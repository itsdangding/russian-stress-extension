{
  "manifest_version": 3,
  "name": "俄语重音助手",
  "version": "1.1.0",
  "description": "在任意普通网页中给俄语文本显示重音，使用本地 OpenRussian 词形词典。",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "stress-data.json"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "俄语重音助手",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_page": "options.html",
  "commands": {
    "accent-current-field": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "给当前选区或输入框添加或取消俄语重音"
    }
  }
}
